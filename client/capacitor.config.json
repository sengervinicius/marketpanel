{
  "appId": "com.the-particle.app",
  "appName": "The Particle",
  "webDir": "dist",
  "backgroundColor": "#07070b",
  "ios": {
    "contentInset": "never",
    "allowsLinkPreview": true,
    "scheme": "Senger",
    "backgroundColor": "#07070b",
    "scrollEnabled": true,
    "preferredContentMode": "mobile"
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0a0a0f"
  },
  "server": {
    "hostname": "the-particle.com",
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#0a0a0f",
      "showSpinner": false,
      "splashImmersive": true,
      "splashFullScreen": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0a0a0f"
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "CapacitorHttp": {
      "enabled": true
    }
  }
}